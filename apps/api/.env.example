# Puerto local. En Render/Railway lo inyecta la plataforma.
PORT=4000

# Sin esta variable la API arranca en memoria con el catálogo inicial.
# Es obligatoria en produccion.
MONGODB_URI=mongodb://127.0.0.1:27017/vital_forge?replicaSet=rs0

# Origenes autorizados en produccion, separados por coma.
# En desarrollo se acepta cualquier origen local.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Valor inicial del envío express gratis (Quito y Valles); luego se edita en el panel.
FREE_SHIPPING_THRESHOLD=75
# Comprueba que el dominio del correo del cliente reciba correo (DNS). on u off.
EMAIL_DOMAIN_CHECK=on
# Horas que se reservan los productos de un pedido por transferencia sin pagar.
ORDER_RESERVATION_HOURS=24
# Peticiones GraphQL por minuto y por IP antes de pedir al cliente que espere.
# Varias personas pueden compartir IP en redes móviles; súbelo si hay reclamos.
GRAPHQL_RATE_LIMIT_PER_MINUTE=120
# Cabecera con la IP real del visitante que pone el proxy de confianza. En Render
# (detras de Cloudflare): cf-connecting-ip. En local, dejar vacia.
CLIENT_IP_HEADER=
# Dias que se conserva la bitacora de auditoria (datos personales; LOPDP).
AUDIT_RETENTION_DAYS=365
# Pedidos sin pagar o sin confirmar que una misma persona puede tener a la vez.
MAX_PENDING_ORDERS_PER_CUSTOMER=2
# Cloudflare Turnstile (opcional): CAPTCHA en registro y pedidos nuevos si están las dos.
# Claves de prueba de Cloudflare que siempre aprueban: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Obligatoria en produccion. AUTH_TOKEN_SECRET necesita 32 caracteres o mas:
# con el valor por defecto cualquiera que lea el repositorio puede firmar tokens.
AUTH_TOKEN_SECRET=
# Crean la cuenta de administracion solo si no existe. En produccion la contrasena
# necesita 12 caracteres o mas y no puede ser comun; despues se puede borrar.
# Usa un correo propio: admin@rawenergy.ec es publico.
ADMIN_EMAIL=admin@rawenergy.ec
ADMIN_PASSWORD=
ADMIN_NAME=Andrea Admin

# Dominio publico de la API. Se usa para construir las URL de las fotos
# subidas desde el panel. Si se omite se deduce de la peticion.
PUBLIC_API_URL=http://localhost:4000
# URL del panel para enlaces de recuperación; requiere SMTP configurado.
ADMIN_APP_URL=http://localhost:5174

# --- Correo saliente ---
# Funciona con cualquier proveedor SMTP: Resend, Brevo, Postmark, Zoho.
# Sin estas variables la tienda funciona igual, pero nadie recibe avisos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Debe ser un dominio verificado en el proveedor.
MAIL_FROM=RawEnergy EC <pedidos@rawenergy.ec>
# A donde llegan los avisos de pedido nuevo. Si se omite se usa ADMIN_EMAIL.
MAIL_OPERATOR=
STORE_NAME=RawEnergy EC
STORE_URL=
STORE_WHATSAPP=

# --- Datos para la transferencia ---
# Se editan en el panel: Configuración > Pagos y envíos. Estas variables solo
# sirven de valor inicial mientras no se haya guardado nada en el panel; vacías,
# se usa Banco Pichincha, ahorros 4755789300, Juan Cevallos.
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_HOLDER=
BANK_DOCUMENT=

# --- Aviso al operador por Telegram ---
# No necesita dominio ni verificacion y el mensaje llega al telefono al momento.
#   1. Crea el bot con @BotFather y copia el token.
#   2. Ponlo aqui, escribile algo al bot desde el telefono.
#   3. npm run telegram:chat -w @vital-forge/api  para ver el chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
